<UserControl x:Name="AuditGogglesViewRoot"
             x:Class="Formula81.XrmToolBox.Tools.AuditGoggles.Views.AuditGogglesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Formula81.XrmToolBox.Tools.AuditGoggles"
             xmlns:localcontrols="clr-namespace:Formula81.XrmToolBox.Tools.AuditGoggles.Controls"
             xmlns:localmocks="clr-namespace:Formula81.XrmToolBox.Tools.AuditGoggles.Mocks"
             xmlns:localmodels="clr-namespace:Formula81.XrmToolBox.Tools.AuditGoggles.Models"
             xmlns:f81partscontrols="clr-namespace:Formula81.XrmToolBox.Shared.Parts.Controls"
             xmlns:f81partsconverters ="clr-namespace:Formula81.XrmToolBox.Shared.Parts.Converters"
             xmlns:f81xrmpartsconverters ="clr-namespace:Formula81.XrmToolBox.Shared.XrmParts.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Formula81.XrmToolBox.Tools.AuditGoggles;component/Resources/LucideIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <f81xrmpartsconverters:IIconifiableToImageConverter x:Key="IIconifiableToImageConverter"/>
            <f81partsconverters:UIElementSizeConverter x:Key="UIElementSizeConverter" />
            <f81partsconverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Same orange as the plugin tile in XrmToolBox -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF8000" />

            <Style x:Key="EmptyHintTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="DimGray" />
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- Context menu of an audit row; DataContext is the EntityAudit, Tag of the row is the EntityAuditViewModel -->
            <ContextMenu x:Key="EntityAuditContextMenu" x:Shared="False">
                <MenuItem Header="Show Details"
                          Command="{Binding PlacementTarget.Tag.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideInfo}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Record in Browser"
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding Record}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideExternalLink}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy Record Id"
                          Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding Record.Id}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideCopy}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <!-- Context menu of an old or new value; the value is the Value of the placement target -->
            <ContextMenu x:Key="EntityAuditValueContextMenu" x:Shared="False">
                <MenuItem Header="Copy Value"
                          Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.Value, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideCopy}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Browser"
                          Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.Value, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.Value.IsEntityReference, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideExternalLink}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add to Audit Records"
                          Command="{Binding PlacementTarget.Tag.AddAuditRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.Value, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Visibility="{Binding PlacementTarget.Value.IsEntityReference, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <MenuItem.Icon>
                        <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucidePlus}" />
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <Style x:Key="EntityAuditValueControlStyle" TargetType="localcontrols:EntityAuditValueControl">
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                <Setter Property="ContextMenu" Value="{StaticResource EntityAuditValueContextMenu}" />
            </Style>

            <DataTemplate x:Key="AuditEntityDataTemplate" DataType="localmodels:AuditEntity">
                <Button x:Name="AuditEntityButton" HorizontalContentAlignment="Stretch"
                        BorderThickness="0,0,0,1" BorderBrush="Transparent"
                        ToolTip="{Binding ToolTip}"
                        Command="{Binding DataContext.AddCommand, ElementName=AuditRecordItemsControl}"
                        CommandParameter="{Binding Name}"
                        Tag="{Binding DataContext, ElementName=AuditEntityGrid}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding PlacementTarget.Tag.FavorizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Header" Value="Unfavorite" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Header" Value="Favorite" />
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Content>
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="4" Width="22" BorderThickness="1" BorderBrush="DarkGray">
                                <Image x:Name="IconImage" Source="{Binding Converter={StaticResource IIconifiableToImageConverter}}" Stretch="None" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" Grid.Column="1" Margin="2,0,0,0" FontSize="14"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Favorite star: always shown for favorites, otherwise only on hover -->
                            <Button Grid.Column="2" Focusable="False" Cursor="Hand"
                                    Command="{Binding Tag.FavorizeCommand, RelativeSource={RelativeSource AncestorType=Button}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Setter Property="ToolTip" Value="Add to Favorites" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="ToolTip" Value="Remove from Favorites" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource LucideStar}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource LucideIconStyle}">
                                                <Setter Property="Stroke" Value="Gray" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Button.Content>
                </Button>
            </DataTemplate>

            <Style x:Key="AttentionButtonStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="Transparent"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLoadRequired}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="AttentionStoryboard">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)"
                                                    From="Transparent" To="Orange" Duration="0:0:0.7"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="AttentionStoryboard"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button x:Name="CloseToolButton">
                    <WrapPanel>
                        <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideCircleX}" />
                        </Viewbox>
                        <Label Content="Close" />
                    </WrapPanel>
                </Button>
                <Separator />
                <Button x:Name="RefreshButton">
                    <WrapPanel>
                        <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideRefreshCw}" />
                        </Viewbox>
                        <Label Content="Refresh" />
                    </WrapPanel>
                </Button>
                <Separator />
                <Button x:Name="AddAuditRecordFXBButton" ToolTip="Add Audit Records with FetchXml Builder">
                    <WrapPanel>
                        <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideCodeXml}" />
                        </Viewbox>
                        <Label Content="FetchXml" />
                    </WrapPanel>
                </Button>
                <Button x:Name="ClearAuditRecordsButton" ToolTip="Clear Audit Records">
                    <WrapPanel>
                        <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideBrushCleaning}" />
                        </Viewbox>
                        <Label Content="Clear" />
                    </WrapPanel>
                </Button>
                <TextBlock x:Name="AuditRecordCountTextBlock" Margin="6,0,4,0" VerticalAlignment="Center"
                           ToolTip="Selected Audit Records">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} / {1} records">
                            <Binding Path="AuditRecordViewModel.AuditRecords.Count" ElementName="AuditGogglesViewRoot" />
                            <Binding Source="{x:Static local:AuditGogglesPluginControl.AuditRecordsMax}" />
                        </MultiBinding>
                    </TextBlock.Text>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <!-- Highlight when the maximum is reached, adding more records is disabled -->
                                <DataTrigger Binding="{Binding AuditRecordViewModel.AuditRecords.Count, ElementName=AuditGogglesViewRoot}"
                                             Value="{x:Static local:AuditGogglesPluginControl.AuditRecordsMax}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ToolBar>
        </ToolBarTray>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="85*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AuditEntityGrid" Grid.RowSpan="4" Background="Gray"
                  DataContext="{Binding AuditEntityViewModel, ElementName=AuditGogglesViewRoot, Mode=OneTime}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" MinHeight="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <f81partscontrols:FilterInputControl x:Name="AuditEntityFilterTextBox" Grid.Column="2"  Margin="0,0,0,2"
                                     FilterChanged="AuditEntityFilterTextBox_FilterChanged" />

                <Label Grid.Row="1" Content="Favorites" Foreground="White" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <ItemsControl x:Name="FavoriteAuditEntityItemsControl" ItemTemplate="{StaticResource AuditEntityDataTemplate}"
                                  ItemsSource="{Binding FavoriteAuditEntitiesViewSource}" />
                </ScrollViewer>
                <Label Grid.Row="3" Content="Audit Entities" Foreground="White" />
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <ItemsControl x:Name="AuditEntityItemsControl" ItemTemplate="{StaticResource AuditEntityDataTemplate}"
                                  ItemsSource="{Binding AuditEntitiesViewSource}">
                        <d:ItemsControl.ItemsSource>
                            <localmocks:AuditEntityItemsControlItemsSource />
                        </d:ItemsControl.ItemsSource>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" />

            <ItemsControl x:Name="AuditRecordItemsControl" Grid.Column="3" Grid.Row="1" Background="LightGray"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          DataContext="{Binding AuditRecordViewModel, ElementName=AuditGogglesViewRoot, Mode=OneTime}"
                          ItemsSource="{Binding AuditRecords}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type localmodels:AuditRecord}">
                        <Border BorderThickness="1" BorderBrush="DarkGray" Margin="1"
                                Padding="4" CornerRadius="4"
                                Background="{Binding ColorCombination.PrimaryBackground, Converter={StaticResource ColorToBrushConverter}}"
                                Tag="{Binding DataContext, ElementName=AuditRecordItemsControl}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Change Color"
                                              Command="{Binding PlacementTarget.Tag.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Height="20" Orientation="Horizontal">
                                <StackPanel.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="EntityDisplayName" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel.ToolTip>
                                <Border Background="White" CornerRadius="4" Width="22" BorderThickness="1" BorderBrush="DarkGray">
                                    <Image x:Name="IconImage" Source="{Binding Converter={StaticResource IIconifiableToImageConverter}}" Stretch="None" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="2,0,0,0"
                                           Foreground="{Binding ColorCombination.PrimaryForeground, Converter={StaticResource ColorToBrushConverter}}"
                                           MaxWidth="100" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Margin="2,0,0,0" Width="16" Height="16" ToolTip="Remove"
                                        Command="{Binding DataContext.RemoveCommand, ElementName=AuditRecordItemsControl}"
                                        CommandParameter="{Binding}">
                                    <Viewbox Style="{StaticResource LucideIconViewboxStyle}" Width="10" Height="10" Margin="0">
                                        <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideX}" StrokeThickness="3" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <d:ItemsControl.ItemsSource>
                    <localmocks:AuditRecordItemsControlItemsSource />
                </d:ItemsControl.ItemsSource>
            </ItemsControl>
            <TextBlock Grid.Column="3" Grid.Row="1"
                       Text="Click an entity on the left to add records, or use FetchXml to add records from a query.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHintTextBlockStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=AuditRecordItemsControl}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <GridSplitter Grid.Column="3" Grid.Row="2" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="3" Grid.Row="3"
                       DataContext="{Binding EntityAuditViewModel, ElementName=AuditGogglesViewRoot, Mode=OneTime}">
                <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                    <ToolBar>
                        <Button x:Name="LoadEntityAuditsButton"
                                Style="{StaticResource AttentionButtonStyle}">
                            <WrapPanel>
                                <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                                    <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideDownload}" />
                                </Viewbox>
                                <Label Content="Load Audits" />
                            </WrapPanel>
                        </Button>
                        <Separator />
                        <Viewbox Style="{StaticResource LucideIconViewboxStyle}" Margin="4,0,0,0" ToolTip="Sort">
                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideArrowUpDown}" />
                        </Viewbox>
                        <ComboBox x:Name="EntityAuditSortComboBox" Width="100" VerticalAlignment="Stretch" Margin="2,4,2,4" ToolTip="Sort"
                                  SelectedItem="{Binding SortDirection}" />
                        <Button x:Name="EditEntityAuditFiltersButton">
                            <WrapPanel>
                                <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                                    <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideFunnel}" />
                                </Viewbox>
                                <Label Content="Edit Filters" />
                                <Border Width="18" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="9" Margin="0,-5,-5,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="11" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding FilterCount}" />
                                </Border>
                            </WrapPanel>
                        </Button>
                        <Button x:Name="EditEntityAuditColumnsButton">
                            <WrapPanel>
                                <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                                    <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideColumns3}" />
                                </Viewbox>
                                <Label Content="Edit Columns" />
                                <Border Width="18" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="9" Margin="0,-5,-5,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasColumns, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding ColumnCount}" />
                                </Border>
                            </WrapPanel>
                        </Button>
                        <Separator />
                        <Button x:Name="ExportEntityAuditsButton" ToolTip="Export the loaded audits to CSV">
                            <WrapPanel>
                                <Viewbox Style="{StaticResource LucideIconViewboxStyle}">
                                    <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideFileSpreadsheet}" />
                                </Viewbox>
                                <Label Content="Export" />
                            </WrapPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
                <StatusBar DockPanel.Dock="Bottom">
                    <StatusBarItem HorizontalContentAlignment="Right">
                        <TextBlock x:Name="EntityAuditStatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" />
                    </StatusBarItem>
                </StatusBar>
                <Grid>
                    <ListView x:Name="EntityAuditListView"
                              AlternationCount="2"
                              ScrollViewer.CanContentScroll="False" SelectionMode="Single"
                              ScrollViewer.ScrollChanged="EntityAuditListView_ScrollChanged"
                              SizeChanged="EntityAuditListView_SizeChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              ItemsSource="{Binding EntityAudits}"
                              IsEnabled="{Binding IsInitiated}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource EntityAuditContextMenu}" />
                                <EventSetter Event="MouseDoubleClick" Handler="EntityAuditListViewItem_MouseDoubleClick" />
                                <Setter Property="BorderThickness" Value="4,0,0,2" />
                                <Setter Property="BorderBrush" Value="{Binding ColorCombination.PrimaryBackground, Converter={StaticResource ColorToBrushConverter}}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="White" />
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F0F0F0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn x:Name="ChangedDateColumn" Header="Changed Date" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="localmodels:EntityAudit">
                                                <TextBlock Text="{Binding ChangedDate, StringFormat=G}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="ChangedByColumn" Header="Changed By" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="localmodels:EntityAudit">
                                                <TextBlock Text="{Binding ChangedByName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="RecordColumn" Header="Record" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="localmodels:EntityAudit">
                                                <Border CornerRadius="4,4,0,0" Margin="-1" Padding="1"
                                                        Background="{Binding ColorCombination.PrimaryBackground, Converter={StaticResource ColorToBrushConverter}}">
                                                    <StackPanel Height="20" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <StackPanel.ToolTip>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} ({1})">
                                                                        <Binding Path="Record.Name" />
                                                                        <Binding Path="Record.EntityDisplayName" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel.ToolTip>
                                                        <Border Background="White" CornerRadius="4" Width="22" BorderThickness="1" BorderBrush="DarkGray">
                                                            <Image Source="{Binding Record, Converter={StaticResource IIconifiableToImageConverter}}" Stretch="None" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Record.Name}" Margin="2,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding ColorCombination.PrimaryForeground, Converter={StaticResource ColorToBrushConverter}}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="EventColumn" Header="Event" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="localmodels:EntityAudit">
                                                <TextBlock Text="{Binding EventName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <!-- Width is set in code behind to fill the remaining space -->
                                    <GridViewColumn x:Name="ChangesColumn" Header="Changes">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type localmodels:EntityAudit}">
                                                <ItemsControl ScrollViewer.HorizontalScrollBarVisibility="Disabled" AlternationCount="2"
                                                              ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="localmodels:EntityAuditDetail">
                                                            <Border x:Name="ItemBorder" Padding="2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource UIElementSizeConverter}, ConverterParameter=20*}" />
                                                                        <ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource UIElementSizeConverter}, ConverterParameter=30*}" />
                                                                        <ColumnDefinition Width="20" />
                                                                        <ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource UIElementSizeConverter}, ConverterParameter=37*}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ChangedFieldName}" ToolTip="{Binding ChangedFieldName}"
                                                                               FontWeight="Bold"/>
                                                                    <localcontrols:EntityAuditValueControl Grid.Column="1" Style="{StaticResource EntityAuditValueControlStyle}"
                                                                                                           Value="{Binding OldValue}" ToolTip="{Binding OldValue}" />
                                                                    <Viewbox Grid.Column="2" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                        <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideArrowRight}" Stroke="Gray" />
                                                                        <Viewbox.Style>
                                                                            <Style TargetType="Viewbox">
                                                                                <Style.Triggers>
                                                                                    <!-- No arrow for a create (no old value) or delete (no new value) -->
                                                                                    <DataTrigger Binding="{Binding OldValue}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding NewValue}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Viewbox.Style>
                                                                    </Viewbox>
                                                                    <localcontrols:EntityAuditValueControl Grid.Column="3" Style="{StaticResource EntityAuditValueControlStyle}"
                                                                                                           Value="{Binding NewValue}" ToolTip="{Binding NewValue}" />
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E0E0E0" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                        <d:ListView.ItemsSource>
                            <localmocks:EntityAuditListViewItemsSource />
                        </d:ListView.ItemsSource>
                    </ListView>
                    <TextBlock Margin="8,32,8,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHintTextBlockStyle}">
                                <Setter Property="Text" Value="Press Load Audits to show the audit history of the selected records." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInitiated}" Value="True">
                                        <Setter Property="Text" Value="No audits found for the selected records and filters." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Text" Value="Loading audits..." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=EntityAuditListView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
