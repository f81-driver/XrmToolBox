<Window x:Class="Formula81.XrmToolBox.Tools.AuditGoggles.Windows.EntityAuditDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:localmodels="clr-namespace:Formula81.XrmToolBox.Tools.AuditGoggles.Models"
        xmlns:f81xrmpartsconverters="clr-namespace:Formula81.XrmToolBox.Shared.XrmParts.Converters"
        mc:Ignorable="d" Height="520" Width="760" MinHeight="300" MinWidth="500"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=localmodels:EntityAudit}"
        Title="Audit Details">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Formula81.XrmToolBox.Tools.AuditGoggles;component/Resources/LucideIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <f81xrmpartsconverters:IIconifiableToImageConverter x:Key="IIconifiableToImageConverter" />

            <Style x:Key="ValueTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="8">
        <!-- Header: record, event, date and user -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="4" Width="22" Height="22" BorderThickness="1" BorderBrush="DarkGray">
                    <Image Source="{Binding Record, Converter={StaticResource IIconifiableToImageConverter}}" Stretch="None" />
                </Border>
                <TextBlock Text="{Binding Record.Name}" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Record.EntityDisplayName, StringFormat=({0})}" Foreground="DimGray" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Foreground="DimGray">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}  ·  {1:G}  ·  {2}">
                        <Binding Path="EventName" />
                        <Binding Path="ChangedDate" />
                        <Binding Path="ChangedByName" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="OpenRecordButton" HorizontalAlignment="Left" Padding="6,2">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Style="{StaticResource LucideMenuIconViewboxStyle}">
                        <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideExternalLink}" />
                    </Viewbox>
                    <TextBlock Text="Open record in browser" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Content="Close" Width="100" HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />
        </Grid>

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="40*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Field" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="Old value" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="New value" FontWeight="Bold" />
        </Grid>

        <Border BorderThickness="1" BorderBrush="DarkGray">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DetailsItemsControl" ItemsSource="{Binding Details}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="localmodels:EntityAuditDetail">
                                <Border x:Name="ItemBorder" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25*" />
                                            <ColumnDefinition Width="35*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="40*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource ValueTextBoxStyle}" Text="{Binding ChangedFieldName, Mode=OneWay}" FontWeight="Bold" />
                                        <TextBox Grid.Column="1" Style="{StaticResource ValueTextBoxStyle}" Text="{Binding OldValue.DisplayText, Mode=OneWay}" />
                                        <Viewbox Grid.Column="2" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path Style="{StaticResource LucideIconStyle}" Data="{StaticResource LucideArrowRight}" Stroke="Gray" />
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OldValue}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NewValue}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                        </Viewbox>
                                        <TextBox Grid.Column="3" Style="{StaticResource ValueTextBoxStyle}" Text="{Binding NewValue.DisplayText, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F0F0F0" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No changed values for this audit." Margin="8" Foreground="DimGray" FontStyle="Italic"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=DetailsItemsControl}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</Window>
