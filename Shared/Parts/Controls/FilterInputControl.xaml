<UserControl x:Name="FilterInputRoot"
             x:Class="Formula81.XrmToolBox.Shared.Parts.Controls.FilterInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Formula81.XrmToolBox.Shared.Parts.Controls"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="200">
    <!-- Search box: magnifier on the left, placeholder, clear button inside the box only while there is text -->
    <Border CornerRadius="3" Background="White" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#ABADB3" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#7EB4EA" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterInputRoot}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Lucide "search" icon -->
            <Viewbox Width="14" Height="14" IsHitTestVisible="False">
                <Path Data="M11,3 A8,8 0 1 1 11,19 A8,8 0 1 1 11,3 Z M21,21 L16.65,16.65" Width="24" Height="24"
                      Stroke="Gray" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBox x:Name="FilterTextBox" Grid.Column="1" FontSize="12" VerticalContentAlignment="Center"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     TextChanged="FilterTextBox_TextChanged" PreviewKeyDown="FilterTextBox_PreviewKeyDown" />
            <TextBlock Grid.Column="1" IsHitTestVisible="False" Text="{Binding Placeholder, ElementName=FilterInputRoot}"
                       Foreground="Gray" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ClearFilterButton" Grid.Column="2" Width="20" Focusable="False" Cursor="Hand" ToolTip="Clear filter (Esc)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBorder" Background="Transparent" CornerRadius="2" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearBorder" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <!-- Lucide "x" icon -->
                <Viewbox Width="10" Height="10">
                    <Path Data="M18,6 L6,18 M6,6 L18,18" Width="24" Height="24"
                          Stroke="DimGray" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>
