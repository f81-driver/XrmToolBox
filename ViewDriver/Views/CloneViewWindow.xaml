<Window x:Class="Formula81.XrmToolBox.Tools.ViewDriver.Views.CloneViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone View" Height="210" Width="460"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SubmitButton" Content="Clone" Width="100" IsDefault="True" Click="SubmitButton_Click" />
            <Button Content="Cancel" Width="100" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="Name" FontWeight="Bold" />
            <TextBox x:Name="NameTextBox" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center" Padding="2"
                     TextChanged="NameTextBox_TextChanged" />
            <Label Grid.Row="1" Content="Owner" FontWeight="Bold" Margin="0,6,0,0" />
            <ComboBox x:Name="OwnerComboBox" Grid.Column="1" Grid.Row="1" Margin="6,6,0,0" VerticalContentAlignment="Center"
                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayText"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="OwnerComboBox_SelectionChanged">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <TextBlock Grid.Column="1" Grid.Row="2" Margin="8,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                       Text="The copy is saved as a personal view of the owner. Another owner than yourself needs the 'Act on Behalf of Another User' privilege." />
        </Grid>
    </DockPanel>
</Window>
