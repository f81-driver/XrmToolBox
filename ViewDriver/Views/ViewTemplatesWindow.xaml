<Window x:Class="Formula81.XrmToolBox.Tools.ViewDriver.Views.ViewTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Templates" Height="560" Width="780" MinHeight="420" MinWidth="640"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="OK" Width="100" IsDefault="True" Click="OkButton_Click" />
                <Button Content="Cancel" Width="100" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock Foreground="DimGray" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                       Text="Templates work on every table, so they hold the primary name of the table and system columns only. Columns a table does not have are skipped." />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Templates -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="DuplicateButton" Content="Duplicate" Width="80" Click="DuplicateButton_Click"
                            ToolTip="Make an editable copy of the selected template" />
                    <Button x:Name="DeleteButton" Content="Delete" Width="80" Margin="6,0,0,0" Click="DeleteButton_Click"
                            ToolTip="Delete the selected template" />
                </StackPanel>
                <ListBox x:Name="TemplatesListBox" DisplayMemberPath="DisplayName" SelectionChanged="TemplatesListBox_SelectionChanged" />
            </DockPanel>

            <!-- Selected template -->
            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <Border x:Name="LeftOutBorder" DockPanel.Dock="Top" Background="#FFE9D2" Padding="8,6" Margin="0,0,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="LeftOutTextBlock" Foreground="#9A4D00" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="BuiltInTextBlock" DockPanel.Dock="Top" Foreground="DimGray" FontStyle="Italic" Margin="0,0,0,4" TextWrapping="Wrap"
                           Text="Built-in templates cannot be changed. Duplicate one to make your own version." />
                <Grid x:Name="EditorGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,3" Text="Name" />
                    <TextBox x:Name="NameTextBox" Grid.Row="1" Padding="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="NameTextBox_LostFocus" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Description" />
                    <TextBox Grid.Row="3" Padding="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="Columns" />
                    <ListBox x:Name="ColumnsListBox" Grid.Row="5" HorizontalContentAlignment="Stretch" MinHeight="80">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButtonStyle}" Content="✕" ToolTip="Remove the column"
                                            Click="RemoveColumnButton_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButtonStyle}" Content="▼" ToolTip="Move down"
                                            Click="MoveColumnDownButton_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButtonStyle}" Content="▲" ToolTip="Move up"
                                            Click="MoveColumnUpButton_Click" />
                                    <TextBlock DockPanel.Dock="Right" Text="px" Foreground="DimGray" VerticalAlignment="Center" Margin="3,0,6,0" />
                                    <TextBox DockPanel.Dock="Right" Width="50" TextAlignment="Right" VerticalContentAlignment="Center"
                                             Text="{Binding Width}" ToolTip="Width, 25 to 500" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip="{Binding Attribute}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Row="6" Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Add column" Width="90" Margin="6,0,0,0" Click="AddColumnButton_Click" />
                        <ComboBox x:Name="AvailableColumnsComboBox" VerticalContentAlignment="Center" DisplayMemberPath="Label"
                                  ToolTip="The primary name of the table and the system columns most tables have" />
                    </DockPanel>
                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabelStyle}" Text="Sort and filter" />
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sort:" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="SortTextBlock" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="ClearSortButton" Grid.Column="2" Content="Remove" Width="70" Click="ClearSortButton_Click" />
                        <TextBlock Grid.Row="1" Text="Filter:" Foreground="DimGray" VerticalAlignment="Center" Margin="0,4,6,0" />
                        <TextBlock x:Name="FilterTextBlock" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0" />
                        <Button x:Name="ClearFilterButton" Grid.Row="1" Grid.Column="2" Content="Remove" Width="70" Margin="0,4,0,0" Click="ClearFilterButton_Click" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                                   Text="To set the sort and filter, build a view with them and use Save open view as template in the New menu." />
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
